# OrionPulse Data Agent — Environment Variables
# Copy this file to .env and fill in values before starting the server.
#   cp .env.example .env

# ── Environment ───────────────────────────────────────────────────────────────

# Runtime environment. Controls auth defaults (dev = auth off by default).
# Values: dev | staging | prod
ORION_ENV=dev

# ── Database ──────────────────────────────────────────────────────────────────

# Path to the SQLite database file. Run `python data/init_db.py` to seed it.
ORION_DB_PATH=data/orion_sales_agent.db

# ── Analytics defaults ────────────────────────────────────────────────────────

# Number of future periods returned by the /forecast endpoint.
# Must be an integer between 1 and 24.
ORION_DEFAULT_FORECAST_HORIZON=3

# Default time grain for KPI aggregation.
# Values: month | quarter
ORION_DEFAULT_GRAIN=month

# ── SQL safety ────────────────────────────────────────────────────────────────

# Enforce read-only SQL mode. Blocks INSERT/UPDATE/DELETE/DROP at the policy layer.
# Set to false only for development/testing.
ORION_READONLY_SQL=true

# Enable admin operations (e.g. CREATE VIEW via MCP create_sql_view tool).
# Required when ORION_AUTH_PROFILE=PROD_STRICT and admin role operations are needed.
ORION_ADMIN_MODE=false

# Maximum number of rows returned by run_sql / any query endpoint.
ORION_MAX_SQL_LIMIT=500

# ── LLM / AI ──────────────────────────────────────────────────────────────────

# API key for the LLM provider. Required when execution mode includes "llm".
ORION_LLM_API_KEY=

# LLM API base URL. Defaults to OpenAI; swap for any OpenAI-compatible endpoint.
# To use a free local model via Ollama (https://ollama.com):
#   1. Install Ollama and pull a model:  ollama pull llama3.2
#   2. Set the URL and model below:
#      ORION_LLM_BASE_URL=http://localhost:11434/v1
#      ORION_LLM_MODEL=llama3.2
#      ORION_LLM_API_KEY=ollama   ← Ollama ignores the key but httpx requires a non-empty value
ORION_LLM_BASE_URL=https://api.openai.com/v1

# Model identifier passed to the LLM provider.
# OpenAI:  gpt-4o-mini  (cheapest capable model)
# Ollama:  llama3.2 | qwen2.5 | mistral
ORION_LLM_MODEL=gpt-4o-mini

# Maximum number of agent reasoning steps before the agent returns a result.
ORION_LLM_MAX_STEPS=4

# Number of retries when LLM returns malformed JSON.
ORION_LLM_JSON_RETRIES=2

# HTTP timeout (seconds) for each LLM API call.
ORION_LLM_TIMEOUT=30

# ── Agent behaviour ───────────────────────────────────────────────────────────

# Write per-request agent trace files to ORION_AGENT_TRACE_PATH.
# Useful for debugging; do not enable in high-throughput prod environments.
ORION_AGENT_DEBUG_TRACE=false

# Directory where trace JSON files are written.
ORION_AGENT_TRACE_PATH=artifacts/agent-traces

# Path to the JSON file used to persist agent memory across requests.
ORION_MEMORY_FILE=data/agent_memory.json

# ── Execution mode defaults ───────────────────────────────────────────────────

# Default execution mode for web/API requests.
# Values: auto | deterministic | llm
#   auto          — deterministic first, LLM fallback on low-confidence results
#   deterministic — SQL + analytics only, no LLM calls (fast, predictable)
#   llm           — LLM orchestration for all requests (richest output, slower)
ORION_WEB_DEFAULT_MODE=auto

# Default execution mode for CLI invocations.
ORION_CLI_DEFAULT_MODE=deterministic

# ── Skills / knowledge ────────────────────────────────────────────────────────

# Directory containing skills Markdown files loaded at agent startup.
ORION_SKILLS_DIR=skills

# ── Authentication ────────────────────────────────────────────────────────────

# Auth profile. Controls whether tokens are required and which routes are guarded.
# Values: DEV_OPEN | DEV_GUARDED | PROD_STRICT
#
#   DEV_OPEN      — No token required. All routes accessible. Local dev only.
#   DEV_GUARDED   — Tokens validated when provided; missing token still allowed.
#                   Useful for local integration testing.
#   PROD_STRICT   — Token required on every guarded route. Fails hard on missing
#                   or invalid token. Use for staging and production.
#
# If unset, defaults to DEV_OPEN when ORION_ENV=dev, PROD_STRICT otherwise.
ORION_AUTH_PROFILE=DEV_OPEN

# Whether authentication is enforced. Derived from ORION_AUTH_PROFILE if unset.
# Set explicitly to override the profile-based default.
# ORION_AUTH_REQUIRED=false

# Bearer token granting analyst-level access (read KPI, forecast, ask, chat).
# Pass as: X-Orion-Token: <value>
ORION_ANALYST_TOKEN=

# Bearer token granting admin-level access (analytics exports, view creation).
# Pass as: X-Orion-Token: <value>
ORION_ADMIN_TOKEN=

# ── Voice / TTS ───────────────────────────────────────────────────────────────

# Text-to-speech provider for the voice-enabled web UI.
# Values: browser | (provider-specific values when additional providers are added)
ORION_VOICE_PROVIDER=browser

# BCP-47 language tag for TTS output.
ORION_VOICE_LANG=en-US

# Specific voice identifier passed to the TTS provider.
# Leave blank to use the provider's default voice for ORION_VOICE_LANG.
ORION_TTS_VOICE=
